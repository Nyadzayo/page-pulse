# Copy to `.env` (gitignored) and fill in from your GA4 property:
# Admin -> Data streams -> <stream> for the Measurement ID, and
# Measurement Protocol API secrets on the same page for the secret.
# Without a .env file, builds ship with telemetry disabled (no-op).
VITE_TELEMETRY_MEASUREMENT_ID=
VITE_TELEMETRY_API_SECRET=
